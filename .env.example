# Local browser pilot only. Use `uv run --env-file ...` with an untracked env file.
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
GEMINI_LLM_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Optional path to a locally approved manual index. Empty means no bank guidance.
APPROVED_MANUAL_INDEX=
